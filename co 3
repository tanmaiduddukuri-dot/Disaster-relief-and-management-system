print("\n" + "=" * 52)
print("   CO3: CSP — CAMP DELIVERY SCHEDULING")
print("=" * 52)
print("\n  Camps : CampA, CampB, CampC, CampD")
print("  Slots : 1, 2, 3, 4")
print("  Constraints:")
print("    1. All camps get different time slots")
print("    2. CampA slot < CampD slot (order)")
print("    3. |CampB slot - CampC slot| > 1 (non-adjacent)")

print("\n  --- Backtracking + MRV + LCV + Forward Checking ---")
domains = {camp: list(SLOTS) for camp in CAMPS}
solution = backtrack({}, domains)

if solution:
    print(f"\n  Solution found:")
    for camp, slot in sorted(solution.items(), key=lambda x: x[1]):
        print(f"    Slot {slot}: {camp}")
    reason = constraint_violated(solution)
    print(f"  Constraint check: {'ALL SATISFIED' if reason is None else reason}")
else:
    print("\n  No solution found by backtracking.")

print("\n  --- Min-Conflicts Local Search ---")
random.seed(7)
mc_solution = min_conflicts()
if mc_solution:
    print(f"  Solution found:")
    for camp, slot in sorted(mc_solution.items(), key=lambda x: x[1]):
        print(f"    Slot {slot}: {camp}")
    reason = constraint_violated(mc_solution)
    print(f"  Constraint check: {'ALL SATISFIED' if reason is None else reason}")
else:
    print("  No solution found by min-conflicts.")

print("\n" + "=" * 52)
print("   CO3 Complete")
print("=" * 52)
