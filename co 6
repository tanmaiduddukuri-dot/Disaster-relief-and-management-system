print("\n" + "=" * 52)
print("   CO6: HYBRID AI — DISASTER RELIEF PLANNER")
print("=" * 52)

print("\n  Running all modules...")

path, cost, trace = astar_risk("Warehouse", "CampD")
schedule          = csp_schedule()
alloc             = allocate_with_utility(300)

explain(path, cost, schedule, alloc, trace)
ethics_check(alloc)
perf_analysis()

